@model Qlykytucxa.Models.UtilityBills
@{
    Layout = null;
    int electricUsed = Model.NewElectricIndex - Model.OldElectricIndex;
    int waterUsed = Model.NewWaterIndex - Model.OldWaterIndex;
    decimal electricCost = electricUsed * Qlykytucxa.Models.DormConstants.ElectricPrice;
    decimal waterCost = waterUsed * Qlykytucxa.Models.DormConstants.WaterPrice;
    var occupants = ViewBag.Occupants as List<string> ?? new List<string>();

    string qrInfo = $"TIEN DIEN NUOC P{Model.Rooms.RoomNumber} T{Model.BillingMonth}_{Model.BillingYear}";
    string qrUrl = $"https://img.vietqr.io/image/970422-0988888999-compact2.png?amount={(int)Model.TotalAmount}&addInfo={HttpUtility.UrlEncode(qrInfo)}&accountName=BAN%20QUAN%20LY%20KTX";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hóa đơn điện nước #HD@Model.BillId.ToString("D4") - Phòng @Model.Rooms.RoomNumber</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body {
            background-color: #f1f5f9;
            font-family: 'Times New Roman', Times, serif;
            color: #1e293b;
            padding: 25px 0;
        }
        .invoice-card {
            background: #fff;
            max-width: 820px;
            margin: 0 auto;
            padding: 45px 50px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            border-radius: 6px;
        }
        .header-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            border-bottom: 2px solid #0f172a;
            padding-bottom: 18px;
            margin-bottom: 20px;
        }
        .unit-info h5 {
            font-size: 16px;
            font-weight: bold;
            text-transform: uppercase;
            margin-bottom: 3px;
        }
        .unit-info p {
            font-size: 13px;
            margin-bottom: 0;
            color: #475569;
        }
        .invoice-num {
            text-align: right;
        }
        .invoice-title {
            text-align: center;
            margin: 20px 0 25px;
        }
        .invoice-title h3 {
            font-size: 22px;
            font-weight: bold;
            text-transform: uppercase;
            color: #0f172a;
            margin-bottom: 4px;
        }
        .invoice-info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px 30px;
            background: #f8fafc;
            padding: 15px 20px;
            border-radius: 6px;
            border: 1px solid #e2e8f0;
            margin-bottom: 25px;
            font-size: 14.5px;
        }
        .table-charges th {
            background-color: #0f172a !important;
            color: #fff !important;
            font-size: 14px;
        }
        .table-charges td {
            font-size: 14.5px;
        }
        .payment-section {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 25px;
            padding: 20px;
            background: #f8fafc;
            border-radius: 8px;
            border: 1px dashed #cbd5e1;
        }
        .qr-box {
            text-align: center;
        }
        .qr-box img {
            width: 170px;
            height: auto;
            border-radius: 6px;
            border: 1px solid #cbd5e1;
        }
        .floating-bar {
            position: fixed;
            top: 20px;
            right: 25px;
            display: flex;
            gap: 10px;
            z-index: 999;
        }
        @@media print {
            body {
                background: #fff;
                padding: 0;
            }
            .invoice-card {
                box-shadow: none;
                padding: 0;
                margin: 0;
                max-width: 100%;
            }
            .floating-bar {
                display: none !important;
            }
        }
    </style>
</head>
<body>
    <div class="floating-bar no-print">
        <button onclick="window.print()" class="btn btn-primary shadow-sm">
            <i class="bi bi-printer-fill me-1"></i> In hóa đơn / Lưu PDF
        </button>
        <a href="@Url.Action("Index", "UtilityBills")" class="btn btn-secondary shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
    </div>

    <div class="invoice-card">
        <!-- Header -->
        <div class="header-top">
            <div class="unit-info">
                <h5>BAN QUẢN LÝ KÝ TÚC XÁ SINH VIÊN</h5>
                <p>Hệ thống Ký túc xá Đại học &bull; Hotline hỗ trợ: 024 3869 1234</p>
                <p>Địa chỉ: Khu Ký túc xá tập trung, Hà Nội</p>
            </div>
            <div class="invoice-num">
                <div class="fw-bold fs-6">MẪU SỐ: 02/KTX-DN</div>
                <div class="text-danger fw-bold fs-5">Số: HD@Model.BillId.ToString("D4")</div>
                <div class="text-muted small">Ngày in: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
        </div>

        <!-- Tiêu đề -->
        <div class="invoice-title">
            <h3>PHIẾU THU TIỀN ĐIỆN - NƯỚC</h3>
            <div class="fst-italic text-muted">Kỳ thanh toán: Tháng @Model.BillingMonth năm @Model.BillingYear</div>
        </div>

        <!-- Thông tin phòng -->
        <div class="invoice-info-grid">
            <div>
                <strong>Phòng KTX:</strong> Phòng @Model.Rooms.RoomNumber - @((!string.IsNullOrEmpty(Model.Rooms.RoomNumber) && char.IsLetter(Model.Rooms.RoomNumber[0])) ? ("Tòa " + Model.Rooms.RoomNumber[0]) : "Khu KTX")
            </div>
            <div>
                <strong>Loại phòng:</strong> @Model.Rooms.RoomType
            </div>
            <div style="grid-column: span 2;">
                <strong>Sinh viên phòng:</strong> 
                @(occupants.Any() ? string.Join(", ", occupants) : "Chưa có sinh viên đăng ký")
            </div>
            <div>
                <strong>Trạng thái thanh toán:</strong> 
                @if (Model.IsPaid)
                {
                    <span class="badge bg-success ms-1">Đã thanh toán hoàn tất</span>
                }
                else
                {
                    <span class="badge bg-danger ms-1">Chưa thanh toán (Công nợ)</span>
                }
            </div>
            <div>
                <strong>Hạn chót thanh toán:</strong> Ngày 15/@Model.BillingMonth/@Model.BillingYear
            </div>
        </div>

        <!-- Bảng chi tiết tiêu thụ -->
        <div class="table-responsive mb-3">
            <table class="table table-bordered table-charges align-middle mb-0">
                <thead>
                    <tr class="text-center">
                        <th style="width: 50px;">STT</th>
                        <th>Khoản mục</th>
                        <th>Chỉ số đầu</th>
                        <th>Chỉ số cuối</th>
                        <th>Tiêu thụ</th>
                        <th>Đơn giá (VNĐ)</th>
                        <th>Thành tiền (VNĐ)</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="text-center fw-bold">1</td>
                        <td>
                            <strong>Điện sinh hoạt</strong>
                            <div class="small text-muted">Đơn vị: kWh (Số điện)</div>
                        </td>
                        <td class="text-center">@Model.OldElectricIndex</td>
                        <td class="text-center">@Model.NewElectricIndex</td>
                        <td class="text-center fw-bold">@electricUsed kWh</td>
                        <td class="text-end">@Qlykytucxa.Models.DormConstants.ElectricPrice.ToString("N0") đ</td>
                        <td class="text-end fw-bold">@electricCost.ToString("N0") đ</td>
                    </tr>
                    <tr>
                        <td class="text-center fw-bold">2</td>
                        <td>
                            <strong>Nước sinh hoạt</strong>
                            <div class="small text-muted">Đơn vị: m&sup3; (Khối nước)</div>
                        </td>
                        <td class="text-center">@Model.OldWaterIndex</td>
                        <td class="text-center">@Model.NewWaterIndex</td>
                        <td class="text-center fw-bold">@waterUsed m&sup3;</td>
                        <td class="text-end">@Qlykytucxa.Models.DormConstants.WaterPrice.ToString("N0") đ</td>
                        <td class="text-end fw-bold">@waterCost.ToString("N0") đ</td>
                    </tr>
                    <tr class="table-light">
                        <td colspan="6" class="text-end fw-bold py-3 fs-6">TỔNG CỘNG TIỀN PHẢI THANH TOÁN:</td>
                        <td class="text-end fw-bold text-danger py-3 fs-5">@Model.TotalAmount.ToString("N0") VNĐ</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Thanh toán bằng chuyển khoản VietQR -->
        <div class="payment-section">
            <div class="me-3">
                <h6 class="fw-bold text-primary mb-2">
                    <i class="bi bi-qr-code-scan me-1"></i> THANH TOÁN QUA MÃ VIETQR TỰ ĐỘNG
                </h6>
                <p class="small text-muted mb-1">
                    Sinh viên mở ứng dụng ngân hàng bất kỳ (Vietcombank, MB Bank, Techcombank, VPBank, Momo...) quét mã để thanh toán đúng số tiền và nội dung.
                </p>
                <div class="small">
                    <div>&bull; <strong>Ngân hàng thụ hưởng:</strong> MBBank (Ngân hàng Quân đội)</div>
                    <div>&bull; <strong>Số tài khoản:</strong> 0988 888 999</div>
                    <div>&bull; <strong>Chủ tài khoản:</strong> BAN QUAN LY KTX</div>
                    <div>&bull; <strong>Nội dung CK:</strong> <code class="text-danger fw-bold">@qrInfo</code></div>
                </div>
            </div>
            <div class="qr-box">
                <img src="@qrUrl" alt="VietQR Thanh toan" />
                <div class="text-muted small mt-1">Quét bằng App Ngân hàng</div>
            </div>
        </div>

        <!-- Chữ ký -->
        <div class="row mt-4 pt-2 text-center">
            <div class="col-6">
                <div class="fw-bold">ĐẠI DIỆN PHÒNG SINH VIÊN</div>
                <div class="small fst-italic text-muted mb-5">(Ký và ghi rõ họ tên)</div>
            </div>
            <div class="col-6">
                <div class="fw-bold">NGƯỜI LẬP PHIẾU</div>
                <div class="small fst-italic text-muted mb-5">(Ký, họ tên và đóng dấu)</div>
            </div>
        </div>
    </div>
</body>
</html>
