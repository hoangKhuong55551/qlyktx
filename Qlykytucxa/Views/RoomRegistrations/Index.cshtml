@model IEnumerable<Qlykytucxa.Models.RoomRegistrations>

@{
    ViewBag.Title = "Hợp đồng Xếp phòng KTX";
    string searchString = ViewBag.SearchString as string ?? "";
    string statusFilter = ViewBag.StatusFilter as string ?? "";
    string expiryFilter = ViewBag.ExpiryFilter as string ?? "";
}

<div class="card shadow-sm border-0 rounded-4">
    <div class="card-body p-4">
        <!-- Header -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
            <div>
                <h4 class="fw-bold text-dark mb-1">
                    <i class="bi bi-file-earmark-text-fill text-warning me-2"></i>Quản lý Hợp đồng & Xếp phòng Nội trú
                </h4>
                <p class="text-muted mb-0 small">Theo dõi hồ sơ hợp đồng, thời hạn lưu trú, gia hạn và in hợp đồng mẫu chuẩn</p>
            </div>
            <div class="d-flex gap-2">
                <a href="@Url.Action("Transfer", "RoomRegistrations")" class="btn btn-outline-primary px-3 shadow-sm">
                    <i class="bi bi-arrow-left-right me-1"></i> Chuyển phòng KTX
                </a>
                <a href="@Url.Action("Create", "RoomRegistrations")" class="btn btn-success px-3 shadow-sm">
                    <i class="bi bi-plus-circle me-1"></i> Xếp phòng mới
                </a>
            </div>
        </div>

        <!-- Bộ lọc tìm kiếm & hạn hợp đồng -->
        <div class="bg-light p-3 rounded-3 mb-4 border">
            @using (Html.BeginForm("Index", "RoomRegistrations", FormMethod.Get, new { @class = "row g-2 align-items-center" }))
            {
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="searchString" class="form-control border-start-0" 
                               placeholder="Tìm theo Mã SV, Họ tên, Số phòng..." value="@searchString" />
                    </div>
                </div>
                <div class="col-md-3">
                    <select name="statusFilter" class="form-select">
                        <option value="">-- Tất cả trạng thái --</option>
                        <option value="Đang ở" @(statusFilter == "Đang ở" ? "selected" : "")>Đang ở</option>
                        <option value="Đã trả phòng" @(statusFilter == "Đã trả phòng" ? "selected" : "")>Đã trả phòng</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <select name="expiryFilter" class="form-select">
                        <option value="">-- Hạn hợp đồng --</option>
                        <option value="expiring" @(expiryFilter == "expiring" ? "selected" : "")>Sắp hết hạn (30 ngày)</option>
                        <option value="expired" @(expiryFilter == "expired" ? "selected" : "")>Đã quá hạn</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-3 flex-grow-1">Lọc</button>
                    <a href="@Url.Action("Index", "RoomRegistrations")" class="btn btn-outline-secondary" title="Đặt lại">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            }
        </div>

        <!-- Bảng danh sách hợp đồng -->
        <div class="table-responsive">
            <table class="table table-hover align-middle border mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Mã SV</th>
                        <th>Họ và tên</th>
                        <th>Phòng</th>
                        <th>Ngày vào ở</th>
                        <th>Hạn kết thúc</th>
                        <th>Trạng thái hợp đồng</th>
                        <th class="text-end pe-3">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            bool isDangO = (item.Status == "Đang ở" || item.Status == Qlykytucxa.Models.DormConstants.StatusDangO);
                            bool isExpiringSoon = false;
                            bool isExpired = false;

                            if (isDangO && item.CheckOutDate.HasValue)
                            {
                                var daysLeft = (item.CheckOutDate.Value - DateTime.Now).TotalDays;
                                if (daysLeft < 0)
                                {
                                    isExpired = true;
                                }
                                else if (daysLeft <= 30)
                                {
                                    isExpiringSoon = true;
                                }
                            }

                            <tr>
                                <td class="ps-3 fw-bold text-primary">@item.Students.StudentCode</td>
                                <td class="fw-semibold">
                                    @item.Students.FullName
                                    <div class="text-muted small">@item.Students.ClassName</div>
                                </td>
                                <td>
                                    <span class="badge bg-info text-dark">
                                        <i class="bi bi-door-open me-1"></i>Phòng @(item.Rooms != null ? item.Rooms.RoomNumber : "N/A")
                                    </span>
                                </td>
                                <td>@item.CheckInDate.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @if (item.CheckOutDate.HasValue)
                                    {
                                        <span>@item.CheckOutDate.Value.ToString("dd/MM/yyyy")</span>
                                        if (isExpired)
                                        {
                                            <span class="badge bg-danger ms-1">Quá hạn</span>
                                        }
                                        else if (isExpiringSoon)
                                        {
                                            <span class="badge bg-warning text-dark ms-1">Sắp hết</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">Chưa định</span>
                                    }
                                </td>
                                <td>
                                    @if (isDangO)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">
                                            <i class="bi bi-check-circle me-1"></i>Đang hiệu lực
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border">Đã kết thúc</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <div class="d-inline-flex gap-1 align-items-center">
                                        <!-- In hợp đồng -->
                                        <a href="@Url.Action("PrintContract", new { id = item.RegistrationId })" 
                                           class="btn btn-sm btn-outline-dark" title="In hợp đồng A4" target="_blank">
                                            <i class="bi bi-printer"></i>
                                        </a>

                                        @if (isDangO)
                                        {
                                            <!-- Gia hạn hợp đồng modal trigger -->
                                            <button type="button" class="btn btn-sm btn-outline-success" 
                                                    data-bs-toggle="modal" data-bs-target="#extendModal-@item.RegistrationId" 
                                                    title="Gia hạn hợp đồng">
                                                <i class="bi bi-calendar-plus"></i>
                                            </button>

                                            <!-- Thanh lý hợp đồng modal trigger -->
                                            <button type="button" class="btn btn-sm btn-outline-warning text-dark" 
                                                    data-bs-toggle="modal" data-bs-target="#terminateModal-@item.RegistrationId" 
                                                    title="Thanh lý / Trả phòng">
                                                <i class="bi bi-box-arrow-right"></i>
                                            </button>
                                        }

                                        <!-- Các nút CRUD cơ bản -->
                                        <a href="@Url.Action("Edit", new { id = item.RegistrationId })" class="btn btn-sm btn-outline-primary" title="Sửa">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a href="@Url.Action("Details", new { id = item.RegistrationId })" class="btn btn-sm btn-outline-info" title="Chi tiết">
                                            <i class="bi bi-info-circle"></i>
                                        </a>
                                        <a href="@Url.Action("Delete", new { id = item.RegistrationId })" class="btn btn-sm btn-outline-danger" title="Xóa">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>

                                    @if (isDangO)
                                    {
                                        <!-- Modal Gia hạn -->
                                        <div class="modal fade text-start" id="extendModal-@item.RegistrationId" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content">
                                                    @using (Html.BeginForm("ExtendContract", "RoomRegistrations", FormMethod.Post))
                                                    {
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="registrationId" value="@item.RegistrationId" />
                                                        <div class="modal-header">
                                                            <h5 class="modal-title fw-bold">
                                                                <i class="bi bi-calendar-plus text-success me-2"></i>Gia hạn Hợp đồng
                                                            </h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <p class="mb-2">Sinh viên: <strong>@item.Students.FullName</strong> (@item.Students.StudentCode)</p>
                                                            <p class="mb-3">Phòng: <strong>@(item.Rooms != null ? item.Rooms.RoomNumber : "")</strong></p>
                                                            <div class="mb-3">
                                                                <label class="form-label fw-bold">Hạn kết thúc mới:</label>
                                                                <input type="date" name="newCheckOutDate" class="form-control" 
                                                                       value="@(item.CheckOutDate.HasValue ? item.CheckOutDate.Value.AddMonths(6).ToString("yyyy-MM-dd") : DateTime.Now.AddMonths(6).ToString("yyyy-MM-dd"))" required />
                                                                <div class="form-text">Mặc định cộng thêm 6 tháng kể từ hạn hiện tại.</div>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                                                            <button type="submit" class="btn btn-success">Xác nhận Gia hạn</button>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Modal Thanh lý -->
                                        <div class="modal fade text-start" id="terminateModal-@item.RegistrationId" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content">
                                                    @using (Html.BeginForm("TerminateContract", "RoomRegistrations", FormMethod.Post))
                                                    {
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="registrationId" value="@item.RegistrationId" />
                                                        <div class="modal-header">
                                                            <h5 class="modal-title fw-bold text-warning">
                                                                <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>Thanh lý / Chấm dứt Hợp đồng
                                                            </h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <p class="mb-2">Xác nhận thanh lý hợp đồng cho sinh viên <strong>@item.Students.FullName</strong> ra khỏi phòng <strong>@(item.Rooms != null ? item.Rooms.RoomNumber : "")</strong>?</p>
                                                            <div class="mb-3">
                                                                <label class="form-label fw-bold">Lý do thanh lý / trả phòng:</label>
                                                                <input type="text" name="reason" class="form-control" placeholder="Hết hạn học kỳ / Tự nguyện trả phòng / Vi phạm nội quy..." required />
                                                            </div>
                                                            <div class="alert alert-info py-2 small mb-0">
                                                                <i class="bi bi-info-circle me-1"></i> Hệ thống sẽ tự động cập nhật số chỗ trống của phòng này (giảm 1 người đang ở) và ghi nhận ngày trả phòng là hôm nay.
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                                                            <button type="submit" class="btn btn-warning text-dark fw-bold">Xác nhận Thanh lý</button>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary opacity-50"></i>
                                Không tìm thấy hợp đồng nào phù hợp với bộ lọc.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
