@model Qlykytucxa.Models.RoomRegistrations

@{
    ViewBag.Title = "Xep phong cho Sinh vien";
}

<h2 class="text-primary">Xep phong Noi tru</h2>
<hr />

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="row">
        <div class="col-md-6">
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

            <div class="mb-3">
                @Html.LabelFor(model => model.StudentId, "Sinh vien", htmlAttributes: new { @class = "form-label fw-bold" })
                @Html.DropDownList("StudentId", null, "-- Chon sinh vien --", htmlAttributes: new { @class = "form-select" })
                @Html.ValidationMessageFor(model => model.StudentId, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.RoomId, "Phong", htmlAttributes: new { @class = "form-label fw-bold" })
                @Html.DropDownList("RoomId", null, "-- Chon phong --", htmlAttributes: new { @class = "form-select" })
                @Html.ValidationMessageFor(model => model.RoomId, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.CheckInDate, "Ngay vao o", htmlAttributes: new { @class = "form-label fw-bold" })
                @Html.EditorFor(model => model.CheckInDate, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.CheckInDate, "", new { @class = "text-danger" })
                <small class="text-muted">De trong se tu dong lay ngay hom nay</small>
            </div>

            <div class="mt-3">
                <input type="submit" value="Xep phong" class="btn btn-primary" />
                @Html.ActionLink("Quay lai", "Index", null, new { @class = "btn btn-secondary" })
            </div>
        </div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}