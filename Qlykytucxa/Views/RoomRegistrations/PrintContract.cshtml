@model Qlykytucxa.Models.RoomRegistrations
@{
    Layout = null;
    var durationMonths = Model.CheckOutDate.HasValue ? ((Model.CheckOutDate.Value.Year - Model.CheckInDate.Year) * 12 + Model.CheckOutDate.Value.Month - Model.CheckInDate.Month) : 0;
    if (durationMonths <= 0) { durationMonths = 6; }
    var depositAmount = Model.Rooms != null ? Model.Rooms.RoomPrice : 500000;
    string buildingName = (Model.Rooms != null && !string.IsNullOrEmpty(Model.Rooms.RoomNumber) && char.IsLetter(Model.Rooms.RoomNumber[0])) ? ("Tòa " + Model.Rooms.RoomNumber[0]) : "Khu KTX";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hợp đồng nội trú #@Model.RegistrationId - @Model.Students.FullName</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body {
            background-color: #f1f5f9;
            font-family: 'Times New Roman', Times, serif;
            color: #111;
            padding: 20px 0;
        }
        .page-contract {
            background: #fff;
            max-width: 800px;
            margin: 0 auto;
            padding: 50px 60px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            border-radius: 4px;
            line-height: 1.6;
            font-size: 15px;
        }
        .header-national {
            text-align: center;
            margin-bottom: 25px;
        }
        .header-national h5 {
            font-size: 15px;
            font-weight: bold;
            letter-spacing: 0.5px;
            margin-bottom: 2px;
        }
        .header-national h6 {
            font-size: 14px;
            font-weight: bold;
            margin-bottom: 6px;
        }
        .header-national .divider {
            width: 140px;
            height: 1px;
            background-color: #111;
            margin: 0 auto 15px;
        }
        .contract-title {
            text-align: center;
            margin: 25px 0 15px;
        }
        .contract-title h3 {
            font-size: 20px;
            font-weight: bold;
            text-transform: uppercase;
            margin-bottom: 5px;
        }
        .contract-title .code {
            font-style: italic;
            font-size: 13px;
        }
        .section-title {
            font-weight: bold;
            text-transform: uppercase;
            margin-top: 16px;
            margin-bottom: 8px;
            font-size: 15px;
        }
        .party-box {
            margin-bottom: 12px;
        }
        .party-name {
            font-weight: bold;
            font-size: 15px;
            margin-bottom: 6px;
        }
        .info-row {
            display: flex;
            margin-bottom: 4px;
        }
        .info-label {
            width: 160px;
            flex-shrink: 0;
            font-weight: 500;
        }
        .info-val {
            flex-grow: 1;
        }
        .dots {
            border-bottom: 1px dotted #888;
            padding-bottom: 1px;
        }
        .sign-row {
            margin-top: 40px;
            display: flex;
            justify-content: space-between;
            text-align: center;
        }
        .sign-col {
            width: 45%;
        }
        .sign-title {
            font-weight: bold;
            margin-bottom: 4px;
        }
        .sign-sub {
            font-style: italic;
            font-size: 13px;
            margin-bottom: 60px;
        }
        .floating-bar {
            position: fixed;
            top: 20px;
            right: 25px;
            display: flex;
            gap: 10px;
            z-index: 999;
        }
        @@media print {
            body {
                background: #fff;
                padding: 0;
            }
            .page-contract {
                box-shadow: none;
                padding: 0;
                margin: 0;
                max-width: 100%;
            }
            .floating-bar {
                display: none !important;
            }
        }
    </style>
</head>
<body>
    <div class="floating-bar no-print">
        <button onclick="window.print()" class="btn btn-primary shadow-sm">
            <i class="bi bi-printer-fill me-1"></i> In hợp đồng / PDF
        </button>
        <a href="@Url.Action("Index", "RoomRegistrations")" class="btn btn-secondary shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
    </div>

    <div class="page-contract">
        <div class="header-national">
            <h5>CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM</h5>
            <h6>Độc lập - Tự do - Hạnh phúc</h6>
            <div class="divider"></div>
        </div>

        <div class="contract-title">
            <h3>HỢP ĐỒNG THUÊ CHỖ Ở NỘI TRÚ KÝ TÚC XÁ</h3>
            <div class="code">Số: HĐ-@Model.RegistrationId.ToString("D4")/KTX &bull; Ngày lập: @DateTime.Now.ToString("dd/MM/yyyy")</div>
        </div>

        <p class="fst-italic mb-3">
            - Căn cứ Bộ luật Dân sự nước Cộng hòa Xã hội Chủ nghĩa Việt Nam;<br />
            - Căn cứ Quy chế quản lý Ký túc xá sinh viên hiện hành;<br />
            - Căn cứ nhu cầu và nguyện vọng ở nội trú của Sinh viên.
        </p>

        <p>Hôm nay, ngày @DateTime.Now.Day tháng @DateTime.Now.Month năm @DateTime.Now.Year, chúng tôi gồm các bên sau:</p>

        <div class="party-box">
            <div class="party-name">BÊN A (BÊN CHO THUÊ): BAN QUẢN LÝ KÝ TÚC XÁ</div>
            <div class="info-row">
                <span class="info-label">Đại diện bởi:</span>
                <span class="info-val dots">Trưởng Ban Quản lý Ký túc xá</span>
            </div>
            <div class="info-row">
                <span class="info-label">Địa chỉ:</span>
                <span class="info-val dots">Văn phòng Quản lý KTX - Trường Đại học</span>
            </div>
            <div class="info-row">
                <span class="info-label">Số điện thoại:</span>
                <span class="info-val dots">024 3869 1234 / 0988 888 999</span>
            </div>
        </div>

        <div class="party-box">
            <div class="party-name">BÊN B (BÊN THUÊ CHỖ Ở): SINH VIÊN NỘI TRÚ</div>
            <div class="info-row">
                <span class="info-label">Họ và tên:</span>
                <span class="info-val dots fw-bold">@Model.Students.FullName</span>
            </div>
            <div class="info-row">
                <span class="info-label">Mã số sinh viên:</span>
                <span class="info-val dots fw-bold">@Model.Students.StudentCode</span>
            </div>
            <div class="info-row">
                <span class="info-label">Giới tính:</span>
                <span class="info-val dots">@(string.IsNullOrEmpty(Model.Students.Gender) ? "Chưa rõ" : Model.Students.Gender)</span>
            </div>
            <div class="info-row">
                <span class="info-label">Lớp:</span>
                <span class="info-val dots">@(string.IsNullOrEmpty(Model.Students.ClassName) ? "Chưa rõ" : Model.Students.ClassName)</span>
            </div>
            <div class="info-row">
                <span class="info-label">Điện thoại:</span>
                <span class="info-val dots">@(string.IsNullOrEmpty(Model.Students.Phone) ? "Chưa có" : Model.Students.Phone)</span>
            </div>
            <div class="info-row">
                <span class="info-label">Hồ sơ thường trú:</span>
                <span class="info-val dots">Theo hồ sơ lưu trữ KTX sinh viên</span>
            </div>
        </div>

        <p>Hai bên cùng thỏa thuận ký kết hợp đồng nội trú với các điều khoản sau:</p>

        <div class="section-title">ĐIỀU 1: ĐỊA ĐIỂM VÀ THỜI HẠN THUÊ</div>
        <p>
            1.1. Bên A đồng ý bố trí cho Bên B 01 chỗ ở nội trú tại <strong>Phòng @(Model.Rooms != null ? Model.Rooms.RoomNumber : "N/A")</strong> - <strong>@buildingName</strong> (Loại phòng: @(Model.Rooms != null ? Model.Rooms.RoomType : "Tiêu chuẩn")).<br />
            1.2. Thời hạn hợp đồng: Từ ngày <strong>@Model.CheckInDate.ToString("dd/MM/yyyy")</strong> đến ngày <strong>@(Model.CheckOutDate.HasValue ? Model.CheckOutDate.Value.ToString("dd/MM/yyyy") : "Theo quy định")</strong> (Thời gian: @durationMonths tháng).
        </p>

        <div class="section-title">ĐIỀU 2: GIÁ THUÊ, TIỀN CỌC VÀ PHÍ SINH HOẠT</div>
        <p>
            2.1. Đơn giá thuê phòng: <strong>@(Model.Rooms != null ? Model.Rooms.RoomPrice.ToString("N0") : "0") VNĐ / tháng / sinh viên</strong>.<br />
            2.2. Tiền đặt cọc cơ sở vật chất: <strong>@depositAmount.ToString("N0") VNĐ</strong> (sẽ được hoàn trả khi kết thúc hợp đồng nếu không làm hư hao tài sản).<br />
            2.3. Tiền điện, nước và dịch vụ sinh hoạt: Thanh toán theo hóa đơn thực tế phát sinh hàng tháng theo chỉ số công tơ phòng.
        </p>

        <div class="section-title">ĐIỀU 3: QUYỀN VÀ NGHĨA VỤ CỦA CÁC BÊN</div>
        <p>
            3.1. <strong>Nghĩa vụ của Bên B:</strong><br />
            - Chấp hành nghiêm chỉnh nội quy KTX, quy chế trật tự an ninh và phòng cháy chữa cháy.<br />
            - Thanh toán tiền phòng, tiền điện nước đầy đủ, đúng hạn theo thông báo của Ban Quản lý.<br />
            - Giữ gìn vệ sinh chung, bảo vệ tài sản công. Nếu làm mất mát, hư hỏng phải bồi thường theo thời giá.<br />
            - Không tự ý chuyển phòng, dẫn người ngoài vào ngủ qua đêm khi chưa được phép.<br />
            3.2. <strong>Quyền và trách nhiệm của Bên A:</strong><br />
            - Bàn giao chỗ ở đúng thỏa thuận và đảm bảo hệ thống điện, nước, internet vận hành ổn định.<br />
            - Kiểm tra định kỳ hoặc đột xuất việc thực hiện nội quy nội trú.<br />
            - Có quyền đơn phương chấm dứt hợp đồng nếu Bên B vi phạm nghiêm trọng kỷ luật hoặc nợ tiền phòng quá hạn.
        </p>

        <div class="section-title">ĐIỀU 4: HIỆU LỰC HỢP ĐỒNG</div>
        <p>
            Hợp đồng này được lập thành 02 bản có giá trị pháp lý như nhau, mỗi bên giữ 01 bản để phối hợp thực hiện. Hợp đồng có hiệu lực kể từ ngày ký.
        </p>

        <div class="sign-row">
            <div class="sign-col">
                <div class="sign-title">ĐẠI DIỆN BÊN A</div>
                <div class="sign-sub">(Ký, ghi rõ họ tên và đóng dấu)</div>
            </div>
            <div class="sign-col">
                <div class="sign-title">ĐẠI DIỆN BÊN B</div>
                <div class="sign-sub">(Ký và ghi rõ họ tên)</div>
                <div class="fw-bold mt-4">@Model.Students.FullName</div>
            </div>
        </div>
    </div>
</body>
</html>
