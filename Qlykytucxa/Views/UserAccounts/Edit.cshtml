@model Qlykytucxa.Models.AccountEditViewModel
@using Qlykytucxa.Models

@{
    ViewBag.Title = "Sửa tài khoản";
}

<div class="card shadow-sm border-0 rounded-4">
    <div class="card-body p-4">
        <h4 class="fw-bold text-dark mb-4">
            <i class="bi bi-pencil-square text-primary me-2"></i>Sửa tài khoản <span class="text-primary">@Model.Username</span>
        </h4>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Id)

            <div class="row">
                <div class="col-md-6 col-lg-5">
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Username, new { @class = "form-label fw-bold" })
                        <input type="text" class="form-control" value="@Model.Username" disabled />
                        <div class="form-text">Tên đăng nhập không thể thay đổi.</div>
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.FullName, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.FullName, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Role, new { @class = "form-label fw-bold" })
                        @Html.DropDownListFor(m => m.Role, new SelectList(new[]
                        {
                            new { Value = UserRoles.Staff, Text = "Nhân viên (xử lý sự cố, xem bảng tin)" },
                            new { Value = UserRoles.Admin, Text = "Quản trị viên (toàn quyền)" }
                        }, "Value", "Text", Model.Role), new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.Role, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mt-4 d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-lg me-1"></i> Lưu thay đổi
                        </button>
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Quay lại</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
