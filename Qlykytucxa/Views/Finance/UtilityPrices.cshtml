@model List<Qlykytucxa.Models.UtilityPrice>
@{
    ViewBag.Title = "Bảng giá điện nước";
    var current = ViewBag.CurrentPrice as Qlykytucxa.Models.UtilityPrice;
    var nextMonth = DateTime.Today.AddMonths(1);
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold text-dark mb-1">
            <i class="bi bi-lightning-charge-fill text-warning me-2"></i>Bảng giá Điện Nước
        </h4>
        <p class="text-muted mb-0 small">Mỗi hóa đơn được tính theo đơn giá có hiệu lực tại kỳ (tháng) của hóa đơn và lưu lại đơn giá đó, nên đổi giá không làm sai hóa đơn cũ.</p>
    </div>
    <a href="@Url.Action("Index", "UtilityBills")" class="btn btn-outline-secondary px-3 shadow-sm">
        <i class="bi bi-receipt-cutoff me-1"></i> Hóa đơn điện nước
    </a>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card border-0 rounded-4 shadow-sm mb-4">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3">Đơn giá đang áp dụng (tháng @DateTime.Today.ToString("MM/yyyy"))</h5>
                <div class="d-flex gap-4">
                    <div><div class="small text-muted">Điện</div><div class="fs-4 fw-bold">@current.ElectricPrice.ToString("N0") đ/kWh</div></div>
                    <div><div class="small text-muted">Nước</div><div class="fs-4 fw-bold">@current.WaterPrice.ToString("N0") đ/m³</div></div>
                </div>
            </div>
        </div>

        <div class="card border-0 rounded-4 shadow-sm">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3"><i class="bi bi-plus-circle me-1"></i>Thêm mức giá mới</h5>
                @using (Html.BeginForm("AddUtilityPrice", "Finance", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-bold">Áp dụng từ tháng</label>
                            <select name="month" class="form-select">
                                @for (int m = 1; m <= 12; m++)
                                {
                                    <option value="@m" @(m == nextMonth.Month ? "selected" : "")>Tháng @m</option>
                                }
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold">Năm</label>
                            <input type="number" name="year" class="form-control" value="@nextMonth.Year" min="2000" max="2100" required />
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-bold">Giá điện (đ/kWh)</label>
                            <input type="number" name="electricPrice" class="form-control" min="1" step="1" value="@current.ElectricPrice.ToString("0")" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold">Giá nước (đ/m³)</label>
                            <input type="number" name="waterPrice" class="form-control" min="1" step="1" value="@current.WaterPrice.ToString("0")" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Ghi chú</label>
                        <input type="text" name="note" class="form-control" maxlength="200" placeholder="VD: Theo biểu giá EVN mới" />
                    </div>
                    <div class="alert alert-info py-2 small">
                        Hóa đơn đã lập giữ nguyên đơn giá cũ. Hóa đơn <strong>chưa thu</strong> thuộc kỳ áp dụng sẽ được tính lại theo giá mới khi bạn sửa hóa đơn đó.
                    </div>
                    <button type="submit" class="btn btn-primary">Lưu mức giá</button>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card border-0 rounded-4 shadow-sm">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3">Lịch sử đơn giá</h5>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Áp dụng từ kỳ</th>
                                <th>Điện</th>
                                <th>Nước</th>
                                <th>Ghi chú</th>
                                <th>Người tạo</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model)
                            {
                                bool isCurrent = current != null && p.Id == current.Id;
                                <tr class="@(isCurrent ? "table-success" : "")">
                                    <td class="fw-bold">@p.EffectiveFrom.ToString("MM/yyyy") @if (isCurrent) { <span class="badge bg-success ms-1">Đang áp dụng</span> } else if (p.EffectiveFrom > DateTime.Today) { <span class="badge bg-info text-dark ms-1">Sắp áp dụng</span> }</td>
                                    <td>@p.ElectricPrice.ToString("N0") đ</td>
                                    <td>@p.WaterPrice.ToString("N0") đ</td>
                                    <td class="small">@p.Note</td>
                                    <td class="small text-muted">@p.CreatedBy<br />@p.CreatedAt.ToString("dd/MM/yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
