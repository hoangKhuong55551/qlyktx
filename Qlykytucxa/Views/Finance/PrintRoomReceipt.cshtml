@model Qlykytucxa.Models.RoomFeePayment
@{
    Layout = null;
    string qrInfo = $"TIEN PHONG {Model.StudentCode} P{Model.RoomNumber}";
    string qrUrl = $"https://img.vietqr.io/image/970422-0988888999-compact2.png?amount={(int)Model.Amount}&addInfo={HttpUtility.UrlEncode(qrInfo)}&accountName=BAN%20QUAN%20LY%20KTX";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Phiếu thu tiền phòng - @Model.StudentName (P.@Model.RoomNumber)</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body {
            background-color: #f1f5f9;
            font-family: 'Times New Roman', Times, serif;
            color: #1e293b;
            padding: 25px 0;
        }
        .receipt-card {
            background: #fff;
            max-width: 750px;
            margin: 0 auto;
            padding: 40px 50px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            border-radius: 6px;
        }
        .header-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            border-bottom: 2px solid #0f172a;
            padding-bottom: 15px;
            margin-bottom: 20px;
        }
        .unit-info h5 {
            font-size: 15px;
            font-weight: bold;
            text-transform: uppercase;
            margin-bottom: 2px;
        }
        .unit-info p {
            font-size: 13px;
            margin-bottom: 0;
            color: #475569;
        }
        .receipt-title {
            text-align: center;
            margin: 15px 0 20px;
        }
        .receipt-title h3 {
            font-size: 20px;
            font-weight: bold;
            text-transform: uppercase;
            color: #0f172a;
            margin-bottom: 4px;
        }
        .info-row {
            display: flex;
            margin-bottom: 8px;
            font-size: 15px;
        }
        .info-label {
            width: 170px;
            flex-shrink: 0;
            font-weight: 500;
        }
        .info-dots {
            flex-grow: 1;
            border-bottom: 1px dotted #94a3b8;
            padding-bottom: 1px;
        }
        .payment-qr-box {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #f8fafc;
            border: 1px dashed #cbd5e1;
            padding: 15px 20px;
            border-radius: 8px;
            margin-top: 20px;
        }
        .payment-qr-box img {
            width: 150px;
            height: auto;
            border-radius: 4px;
            border: 1px solid #cbd5e1;
        }
        .floating-bar {
            position: fixed;
            top: 20px;
            right: 25px;
            display: flex;
            gap: 10px;
            z-index: 999;
        }
        @@media print {
            body {
                background: #fff;
                padding: 0;
            }
            .receipt-card {
                box-shadow: none;
                padding: 0;
                margin: 0;
                max-width: 100%;
            }
            .floating-bar {
                display: none !important;
            }
        }
    </style>
</head>
<body>
    <div class="floating-bar no-print">
        <button onclick="window.print()" class="btn btn-primary shadow-sm">
            <i class="bi bi-printer-fill me-1"></i> In phiếu thu / Lưu PDF
        </button>
        <a href="@Url.Action("RoomFees", "Finance")" class="btn btn-secondary shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
    </div>

    <div class="receipt-card">
        <div class="header-top">
            <div class="unit-info">
                <h5>BAN QUẢN LÝ KÝ TÚC XÁ SINH VIÊN</h5>
                <p>Hệ thống Ký túc xá Đại học &bull; ĐT: 024 3869 1234</p>
                <p>Địa chỉ: Khu Ký túc xá sinh viên</p>
            </div>
            <div class="text-end">
                <div class="fw-bold">MẪU SỐ: 01/KTX-TP</div>
                <div class="text-danger fw-bold fs-5">Số: PT@Model.Id.ToString("D4")</div>
                <div class="text-muted small">Ngày lập: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
        </div>

        <div class="receipt-title">
            <h3>PHIẾU THU TIỀN THUÊ PHÒNG KTX</h3>
            <div class="fst-italic text-muted">Kỳ thu: @Model.SemesterPeriod</div>
        </div>

        <div class="info-row">
            <span class="info-label">Họ và tên sinh viên:</span>
            <span class="info-dots fw-bold text-dark">@Model.StudentName</span>
        </div>
        <div class="info-row">
            <span class="info-label">Mã số sinh viên:</span>
            <span class="info-dots fw-bold text-primary">@Model.StudentCode</span>
        </div>
        <div class="info-row">
            <span class="info-label">Phòng nội trú:</span>
            <span class="info-dots fw-bold">Phòng @Model.RoomNumber</span>
        </div>
        <div class="info-row">
            <span class="info-label">Lý do thu tiền:</span>
            <span class="info-dots">Nộp tiền thuê chỗ ở ký túc xá (@Model.SemesterPeriod)</span>
        </div>
        <div class="info-row">
            <span class="info-label">Số tiền thu:</span>
            <span class="info-dots fw-bold text-danger fs-5">@Model.Amount.ToString("N0") VNĐ</span>
        </div>
        <div class="info-row">
            <span class="info-label">Trạng thái phiếu:</span>
            <span class="info-dots">
                @if (Model.IsPaid)
                {
                    <span class="badge bg-success">ĐÃ THU TIỀN (Ngày @(Model.PaidDate.HasValue ? Model.PaidDate.Value.ToString("dd/MM/yyyy") : ""))</span>
                    <span class="ms-1">- Hình thức: @Model.PaymentMethod</span>
                }
                else
                {
                    <span class="badge bg-danger">CHƯA THANH TOÁN (Hạn nộp: @Model.DueDate.ToString("dd/MM/yyyy"))</span>
                }
            </span>
        </div>

        @if (!Model.IsPaid)
        {
            <div class="payment-qr-box">
                <div>
                    <h6 class="fw-bold text-primary mb-1">
                        <i class="bi bi-qr-code-scan me-1"></i> THANH TOÁN TIỀN PHÒNG QUA VIETQR
                    </h6>
                    <p class="small text-muted mb-2">Sinh viên quét mã bằng bất kỳ App Ngân hàng (MB, VCB, Momo...) để thanh toán nhanh:</p>
                    <div class="small">
                        <div>&bull; <strong>Số tài khoản:</strong> 0988 888 999 (MBBank)</div>
                        <div>&bull; <strong>Chủ tài khoản:</strong> BAN QUAN LY KTX</div>
                        <div>&bull; <strong>Nội dung:</strong> <code class="text-danger fw-bold">@qrInfo</code></div>
                    </div>
                </div>
                <div class="text-center">
                    <img src="@qrUrl" alt="VietQR Tien Phong" />
                    <div class="small text-muted mt-1">Quét bằng App Ngân hàng</div>
                </div>
            </div>
        }

        <div class="row mt-4 pt-3 text-center">
            <div class="col-6">
                <div class="fw-bold">NGƯỜI NỘP TIỀN</div>
                <div class="small fst-italic text-muted mb-5">(Ký và ghi rõ họ tên)</div>
                <div class="fw-bold">@Model.StudentName</div>
            </div>
            <div class="col-6">
                <div class="fw-bold">NGƯỜI LẬP PHIẾU THU</div>
                <div class="small fst-italic text-muted mb-5">(Ký, họ tên và đóng dấu)</div>
                <div class="fw-bold">Ban Quản lý KTX</div>
            </div>
        </div>
    </div>
</body>
</html>
