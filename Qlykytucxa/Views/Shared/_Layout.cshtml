            background-size: 600px 600px, 100% 100%;
            color: var(--sidebar-text);
            display: flex;
            flex-direction: column;
            z-index: 1050;
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            overflow-y: auto;
            transform: translateX(-100%);
            transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.3s ease;
            border-right: 1px solid rgba(255, 255, 255, 0.06);
            scrollbar-width: thin;
            scrollbar-color: rgba(255, 255, 255, 0.15) transparent;
        }

        #sidebar.open {
            transform: translateX(0);
            box-shadow: 12px 0 40px rgba(17, 19, 64, 0.35);
        }

        /* Lớp mờ phía sau khi menu mở */
        #sidebarBackdrop {
            position: fixed;
            inset: 0;
            background: rgba(26, 29, 92, 0.18);
            z-index: 1049;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s ease;
        }

        body.sidebar-open #sidebarBackdrop {
            opacity: 1;
        }

        /* Vùng mép trái + nút mở menu */
        #sidebarEdge {
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            width: 10px;
            z-index: 1040;
        }

        #sidebarTrigger {
            position: fixed;
            top: 50%;
            left: 0;
            transform: translateY(-50%);
            z-index: 1045;
            width: 24px;
            height: 84px;
            border: none;
            border-radius: 0 14px 14px 0;
            background: var(--brand-2);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: 4px 0 18px rgba(67, 97, 238, 0.35);
            transition: width 0.2s ease, opacity 0.2s ease;
            padding: 0;
        }

        #sidebarTrigger:hover {
            width: 34px;
        }

        #sidebarTrigger i {
            font-size: 1rem;
            animation: nudge 1.8s ease-in-out infinite;
        }

        @@keyframes nudge {
            0%, 100% { transform: translateX(0); }
            50% { transform: translateX(3px); }
        }

        body.sidebar-open #sidebarTrigger {
            opacity: 0;
            pointer-events: none;
        }

        /* Thương hiệu */
        .sidebar-brand {
            height: var(--topbar-height);
            display: flex;
            align-items: center;
            padding: 0 1.25rem;
            color: #ffffff;
            text-decoration: none;
            gap: 12px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
            flex-shrink: 0;
        }

        .sidebar-brand:hover {
            color: #ffffff;
        }

        .brand-mark {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            background: var(--brand-2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            color: #fff;
            box-shadow: 0 6px 16px rgba(67, 97, 238, 0.45);
            flex-shrink: 0;
        }

        .brand-name {
            display: block;
            font-weight: 800;
            font-size: 1.15rem;
            letter-spacing: -0.2px;
            line-height: 1.1;
        }

        .brand-name span {
            color: #8ea2f5;
        }

        .brand-tagline {
            display: block;
            font-size: 0.7rem;
            color: #8f97cf;
            font-weight: 500;
            margin-top: 2px;
        }

        .sidebar-menu {
            padding: 0.75rem 0.85rem 1rem;
            list-style: none;
            margin: 0;
            flex-grow: 1;
        }

        .sidebar-heading {
            font-size: 0.68rem;
            text-transform: uppercase;
            font-weight: 700;
            letter-spacing: 1.1px;
            color: #7c84bf;
            padding: 1rem 0.85rem 0.4rem;
        }

        .nav-item {
            margin-bottom: 2px;
        }

        .nav-link-custom {
            position: relative;
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0.5rem 0.85rem 0.5rem 0.5rem;
            color: #cdd2f0;
            text-decoration: none;
            border-radius: 999px;
            font-weight: 500;
            font-size: 0.9rem;
            transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
        }

        .nav-link-custom i {
            font-size: 1.05rem;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #a2aadb;
            background: rgba(255, 255, 255, 0.04);
            transition: all 0.2s ease;
            flex-shrink: 0;
        }

        .nav-link-custom:hover {
            color: #ffffff;
            background-color: var(--sidebar-hover);
            transform: translateX(3px);
        }

        .nav-link-custom:hover i {
            color: #ffffff;
            background: rgba(67, 97, 238, 0.45);
        }

        .nav-link-custom.active {
            color: #ffffff;
            background: var(--brand-2);
            box-shadow: 0 8px 20px rgba(67, 97, 238, 0.4);
            font-weight: 600;
        }

        .nav-link-custom.active i {
            color: #ffffff;
            background: rgba(255, 255, 255, 0.18);
        }

        .nav-link-custom.active:hover {
            transform: none;
        }

        /* Thẻ người dùng cuối sidebar */
        .sidebar-user {
            margin: 0 0.85rem 0.85rem;
            padding: 0.75rem;
            border-radius: 14px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.07);
            display: flex;
            align-items: center;
            gap: 10px;
            flex-shrink: 0;
        }

        .sidebar-user .user-info {
            min-width: 0;
        }

        .sidebar-user .user-name {
            color: #fff;
            font-weight: 600;
            font-size: 0.85rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .sidebar-user .user-role {
            font-size: 0.72rem;
            color: #a2aadb;
        }

        .sidebar-user .logout-btn {
            margin-left: auto;
            width: 34px;
            height: 34px;
            border-radius: 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #fca5a5;
            background: rgba(239, 68, 68, 0.12);
            text-decoration: none;
            transition: background 0.2s ease;
            flex-shrink: 0;
        }

        .sidebar-user .logout-btn:hover {
            background: rgba(239, 68, 68, 0.25);
            color: #fff;
        }

        /* ===== Nội dung chính ===== */
        #content-wrapper {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            min-width: 0;
            min-height: 100vh;
        }

        /* Thanh tiêu đề trên cùng (kính mờ) */
        .topbar {
            height: var(--topbar-height);
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: saturate(180%) blur(14px);
            -webkit-backdrop-filter: saturate(180%) blur(14px);
            border-bottom: 1px solid #eceef5;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 1.75rem;
            position: sticky;
            top: 0;
            z-index: 999;
            gap: 1rem;
        }

        .topbar-btn {
            width: 40px;
            height: 40px;
            background: #fff;
            border: 1px solid #e6e8f2;
            font-size: 1.05rem;
            color: #1a1d3a;
            cursor: pointer;
            border-radius: 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
            flex-shrink: 0;
            text-decoration: none;
        }

        .topbar-btn:hover {
            background: #eef1fe;
            border-color: #cdd6fb;
            color: #4361ee;
        }

        .topbar-btn.danger:hover {
            background: #fef2f2;
            border-color: #fecaca;
            color: #dc2626;
        }

        .page-heading {
            min-width: 0;
        }

        .page-heading .crumb {
            font-size: 0.7rem;
            color: #4361ee;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.9px;
            line-height: 1;
            margin-bottom: 4px;
        }

        .page-heading .title {
            font-size: 1.2rem;
            font-weight: 600;
            color: #1a1d3a;
            line-height: 1.2;
            letter-spacing: -0.3px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .date-chip {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 9px 12px;
            border-radius: 12px;
            background: #f3f4f8;
            color: #4361ee;
            font-size: 0.8rem;
            font-weight: 600;
        }

        .admin-profile {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 3px 14px 3px 3px;
            border-radius: 40px;
            background: #fff;
            border: 1px solid #e6e8f2;
        }

        .admin-avatar {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: var(--brand-2);
            color: #ffffff;
            font-weight: 700;
            font-size: 0.78rem;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            box-shadow: 0 4px 10px rgba(67, 97, 238, 0.35);
        }

        .role-chip {
            display: inline-block;
            font-size: 0.66rem;
            font-weight: 700;
            color: #4361ee;
            background: #eef1fe;
            padding: 2px 8px;
            border-radius: 20px;
            margin-top: 3px;
        }

        .main-content {
            padding: 1.75rem;
            flex-grow: 1;
            animation: pageIn 0.35s ease-out both;
        }

        @@keyframes pageIn {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: none; }
        }

        .app-footer {
            padding: 0.5rem 1.75rem 1.5rem;
            color: #9aa0b8;
            font-size: 0.8rem;
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 0.5rem;
        }

        @@media (max-width: 576px) {
            .topbar { padding: 0 1rem; }
            .main-content { padding: 1rem; }
            .app-footer { padding: 0.5rem 1rem 1rem; }
        }
    </style>
</head>
<body>
    <div id="wrapper">
        <!-- Vùng mép trái + nút mở menu: rê chuột vào để hiện thanh công cụ -->
        <div id="sidebarEdge"></div>
        <div id="sidebarBackdrop"></div>
        <button type="button" id="sidebarTrigger" title="Mở menu" aria-label="Mở menu" aria-controls="sidebar" aria-expanded="false">
            <i class="bi bi-chevron-double-right"></i>
        </button>

        <!-- Sidebar -->
        <nav id="sidebar">
            <a href="@Url.Action("Index", "Home")" class="sidebar-brand">
                <div class="brand-mark"><i class="bi bi-buildings-fill"></i></div>
                <div>
                    <span class="brand-name">Dorm<span>Nest</span></span>
                    <span class="brand-tagline">Quản lý Ký túc xá thông minh</span>
                </div>
            </a>

            <ul class="sidebar-menu">
                @if (currentRole == "Student")
                {
                    <li class="sidebar-heading">Sinh viên Nội trú</li>
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "StudentPortal")" class="nav-link-custom @(ViewContext.RouteData.Values["controller"].ToString() == "StudentPortal" && ViewContext.RouteData.Values["action"].ToString() == "Index" ? "active" : "")">
                            <i class="bi bi-person-workspace"></i>
                            <span class="nav-text">Cổng thông tin SV</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("ReportIncident", "StudentPortal")" class="nav-link-custom @(ViewContext.RouteData.Values["action"].ToString() == "ReportIncident" ? "active" : "")">
                            <i class="bi bi-tools"></i>
                            <span class="nav-text">Báo hỏng phòng</span>
                        </a>
                    </li>
                }
                else if (currentRole == "Staff")
                {
                    <li class="sidebar-heading">Kỹ thuật viên KTX</li>
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "Incidents")" class="nav-link-custom @(ViewContext.RouteData.Values["controller"].ToString() == "Incidents" ? "active" : "")">
                            <i class="bi bi-tools"></i>
                            <span class="nav-text">Báo hỏng & Sửa chữa</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "Announcements")" class="nav-link-custom @(ViewContext.RouteData.Values["controller"].ToString() == "Announcements" ? "active" : "")">
                            <i class="bi bi-megaphone-fill"></i>
                            <span class="nav-text">Bảng tin KTX</span>
                        </a>
                    </li>
                }
                else if (currentRole == "Admin")
                {
                    <li class="sidebar-heading">Bảng điều khiển</li>
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "Home")" class="nav-link-custom @(ViewContext.RouteData.Values["controller"].ToString() == "Home" ? "active" : "")">
                            <i class="bi bi-grid-1x2-fill"></i>
                            <span class="nav-text">Tổng quan</span>
                        </a>
                    </li>

                    <li class="sidebar-heading">Quản lý nội trú</li>
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "Students")" class="nav-link-custom @(ViewContext.RouteData.Values["controller"].ToString() == "Students" ? "active" : "")">
                            <i class="bi bi-people-fill"></i>
                            <span class="nav-text">Quản lý Sinh viên</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "Rooms")" class="nav-link-custom @(ViewContext.RouteData.Values["controller"].ToString() == "Rooms" ? "active" : "")">
                            <i class="bi bi-door-open-fill"></i>
                            <span class="nav-text">Tòa nhà & Phòng</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "RoomRegistrations")" class="nav-link-custom @(ViewContext.RouteData.Values["controller"].ToString() == "RoomRegistrations" && ViewContext.RouteData.Values["action"].ToString() != "Transfer" ? "active" : "")">
                            <i class="bi bi-file-earmark-text-fill"></i>
                            <span class="nav-text">Hợp đồng Nội trú</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("Transfer", "RoomRegistrations")" class="nav-link-custom @(ViewContext.RouteData.Values["action"].ToString() == "Transfer" ? "active" : "")">
                            <i class="bi bi-arrow-left-right"></i>
                            <span class="nav-text">Chuyển phòng KTX</span>
                        </a>
                    </li>

                    <li class="sidebar-heading">Tài chính & Dịch vụ</li>
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "Finance")" class="nav-link-custom @(ViewContext.RouteData.Values["controller"].ToString() == "Finance" && ViewContext.RouteData.Values["action"].ToString() == "Index" ? "active" : "")">
                            <i class="bi bi-wallet2"></i>
                            <span class="nav-text">Báo cáo Thu - Chi</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("RoomFees", "Finance")" class="nav-link-custom @(ViewContext.RouteData.Values["action"].ToString() == "RoomFees" ? "active" : "")">
                            <i class="bi bi-cash-coin"></i>
                            <span class="nav-text">Thu Tiền Phòng</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("Debts", "Finance")" class="nav-link-custom @(ViewContext.RouteData.Values["action"].ToString() == "Debts" ? "active" : "")">
                            <i class="bi bi-exclamation-triangle"></i>
                            <span class="nav-text">Công nợ quá hạn</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("Deposits", "Finance")" class="nav-link-custom @(ViewContext.RouteData.Values["action"].ToString() == "Deposits" ? "active" : "")">
                            <i class="bi bi-safe"></i>
                            <span class="nav-text">Tiền đặt cọc</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "UtilityBills")" class="nav-link-custom @(ViewContext.RouteData.Values["controller"].ToString() == "UtilityBills" ? "active" : "")">
                            <i class="bi bi-receipt-cutoff"></i>
                            <span class="nav-text">Hóa đơn Điện Nước</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("UtilityPrices", "Finance")" class="nav-link-custom @(ViewContext.RouteData.Values["action"].ToString() == "UtilityPrices" ? "active" : "")">
                            <i class="bi bi-lightning-charge"></i>
                            <span class="nav-text">Bảng giá Điện Nước</span>
                        </a>
                    </li>

                    <li class="sidebar-heading">Bảo trì & Bảng tin</li>
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "Incidents")" class="nav-link-custom @(ViewContext.RouteData.Values["controller"].ToString() == "Incidents" ? "active" : "")">
                            <i class="bi bi-tools"></i>
                            <span class="nav-text">Báo hỏng & Sửa chữa</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "Announcements")" class="nav-link-custom @(ViewContext.RouteData.Values["controller"].ToString() == "Announcements" ? "active" : "")">
                            <i class="bi bi-megaphone-fill"></i>
                            <span class="nav-text">Bảng tin Thông báo</span>
                        </a>
                    </li>

                    <li class="sidebar-heading">Hệ thống</li>
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "UserAccounts")" class="nav-link-custom @(ViewContext.RouteData.Values["controller"].ToString() == "UserAccounts" ? "active" : "")">
                            <i class="bi bi-person-gear"></i>
                            <span class="nav-text">Quản lý Tài khoản</span>
                        </a>
                    </li>

                    <li class="sidebar-heading">Cổng Sinh viên</li>
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "StudentPortal")" class="nav-link-custom @(ViewContext.RouteData.Values["controller"].ToString() == "StudentPortal" ? "active" : "")">
                            <i class="bi bi-person-badge"></i>
                            <span class="nav-text">Xem Cổng SV</span>
                        </a>
                    </li>
                }
            </ul>

            <div class="sidebar-user">
                <div class="admin-avatar">@avatarText</div>
                <div class="user-info">
                    <div class="user-name">@currentName</div>
                    <div class="user-role">@roleText</div>
                </div>
                <a href="@Url.Action("Logout", "Account")" class="logout-btn" title="Đăng xuất">
                    <i class="bi bi-box-arrow-right"></i>
                </a>
            </div>
        </nav>

        <!-- Main Content Area -->
        <div id="content-wrapper">
            <!-- Topbar Header -->
            <header class="topbar">
                <div class="d-flex align-items-center gap-3" style="min-width: 0;">
                    <button id="sidebarToggle" class="topbar-btn" title="Mở menu">
                        <i class="bi bi-grid-3x3-gap-fill"></i>
                    </button>
                    <div class="page-heading">
                        <div class="crumb d-none d-sm-block">DormNest</div>
                        <div class="title">@(ViewBag.Title ?? "Hệ thống Quản lý Ký túc xá")</div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <div class="date-chip d-none d-lg-inline-flex">
                        <i class="bi bi-calendar3"></i> @DateTime.Now.ToString("dd/MM/yyyy")
                    </div>
                    <div class="admin-profile">
                        <div class="admin-avatar">@avatarText</div>
                        <div class="d-none d-sm-block text-start lh-1">
                            <span class="d-block fw-semibold text-dark" style="font-size: 0.85rem;">@currentName</span>
                            <span class="role-chip">@roleText</span>
                        </div>
                    </div>
                    <a href="@Url.Action("ChangePassword", "Account")" class="topbar-btn" title="Đổi mật khẩu">
                        <i class="bi bi-key"></i>
                    </a>
                    <a href="@Url.Action("Logout", "Account")" class="topbar-btn danger" title="Đăng xuất">
                        <i class="bi bi-box-arrow-right"></i>
                    </a>
                </div>
            </header>

            <!-- Body Content -->
            <main class="main-content">
                @* Thông báo Toast / Alert động từ TempData *@
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 d-flex align-items-center gap-2" role="alert">
                        <i class="bi bi-check-circle-fill fs-5"></i>
                        <div>@TempData["Success"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 d-flex align-items-center gap-2" role="alert">
                        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                        <div>@TempData["Error"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()
            </main>

            <footer class="app-footer">
                <span>&copy; @DateTime.Now.Year <strong class="text-secondary">DormNest</strong> &middot; Hệ thống quản lý nội trú</span>
                <span>Phiên bản 2.0</span>
            </footer>
        </div>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")

    <script>
        // Thanh công cụ bên trái: ẩn mặc định, rê chuột vào nút ở mép trái để hiện
        $(document).ready(function () {
            var $sidebar = $('#sidebar');
            var $trigger = $('#sidebarTrigger');
            var hideTimer = null;

            function openSidebar() {
                clearTimeout(hideTimer);
                $sidebar.addClass('open');
                $('body').addClass('sidebar-open');
                $trigger.attr('aria-expanded', 'true');
            }

            function closeSidebar() {
                clearTimeout(hideTimer);
                $sidebar.removeClass('open');
                $('body').removeClass('sidebar-open');
                $trigger.attr('aria-expanded', 'false');
            }

            function scheduleClose() {
                clearTimeout(hideTimer);
                hideTimer = setTimeout(closeSidebar, 300);
            }

            // Rê chuột (máy tính)
            $('#sidebarTrigger, #sidebarEdge').on('mouseenter', openSidebar);
            $sidebar.on('mouseenter', openSidebar).on('mouseleave', scheduleClose);
            $('#sidebarTrigger, #sidebarEdge').on('mouseleave', function (e) {
                if (!$(e.relatedTarget).closest('#sidebar').length) scheduleClose();
            });

            // Bấm (điện thoại / màn hình cảm ứng) và nút trên thanh tiêu đề
            $('#sidebarTrigger, #sidebarToggle').on('click', function (e) {
                e.stopPropagation();
                $sidebar.hasClass('open') ? closeSidebar() : openSidebar();
            });

            // Bấm ra ngoài hoặc nhấn Esc để đóng
            $(document).on('click', function (e) {
                if ($sidebar.hasClass('open') && !$(e.target).closest('#sidebar').length) closeSidebar();
            });
            $(document).on('keydown', function (e) {
                if (e.key === 'Escape') closeSidebar();
            });
        });
    </script>

    @RenderSection("scripts", required: false)
</body>
</html>
