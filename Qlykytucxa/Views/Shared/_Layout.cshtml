@{
    var userSession = Session["User"] as Qlykytucxa.Models.UserSession;
    string currentRole = userSession != null ? userSession.Role : (Session["Role"] as string ?? "");
    string currentName = userSession != null ? userSession.FullName : (Session["FullName"] as string ?? "");
    string avatarText = currentRole == "Student" ? "SV" : (currentRole == "Staff" ? "KT" : "AD");
    string roleText = currentRole == "Student" ? "Sinh viên" : (currentRole == "Staff" ? "Kỹ thuật viên" : (currentRole == "Admin" ? "Quản trị viên" : currentRole));
}
