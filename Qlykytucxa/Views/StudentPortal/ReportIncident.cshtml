@model Qlykytucxa.Models.IncidentRequest
@{
    ViewBag.Title = "Gửi Yêu cầu Báo hỏng Phòng";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-0 rounded-4 shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom">
                    <div>
                        <h4 class="fw-bold text-dark mb-1">
                            <i class="bi bi-tools text-warning me-2"></i>Gửi Báo hỏng / Yêu cầu Sửa chữa
                        </h4>
                        <p class="text-muted small mb-0">Ban Quản lý sẽ điều phối kỹ thuật viên đến kiểm tra và xử lý</p>
                    </div>
                    <a href="@Url.Action("Index", "StudentPortal")" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại
                    </a>
                </div>

                @using (Html.BeginForm("ReportIncident", "StudentPortal", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.RoomId)
                    @Html.HiddenFor(m => m.RoomNumber)

                    <div class="bg-light p-3 rounded-3 mb-3 border">
                        <div class="row">
                            <div class="col-6">
                                <span class="text-muted small">Phòng:</span>
                                <div class="fw-bold text-primary fs-5">Phòng @Model.RoomNumber</div>
                            </div>
                            <div class="col-6">
                                <span class="text-muted small">Người gửi báo hỏng:</span>
                                <div class="fw-semibold">@Model.ReporterName</div>
                                @Html.HiddenFor(m => m.ReporterName)
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Title, "Tóm tắt sự cố hư hỏng:", new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.Title, new { @class = "form-control", placeholder = "VD: Hỏng vòi hoa sen, Điều hòa không lạnh, Mất điện ổ cắm...", required = "required" })
                        @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Category, "Hạng mục thiết bị:", new { @class = "form-label fw-bold" })
                        <select name="Category" class="form-select" required>
                            <option value="Điện">Hệ thống Điện (Bóng đèn, Ổ cắm, Quạt trần)</option>
                            <option value="Nước">Hệ thống Nước (Vòi sen, Bồn cầu, Vòi rửa mặt)</option>
                            <option value="Điều hòa">Điều hòa / Máy lạnh</option>
                            <option value="Giường chiếu / Nội thất">Giường chiếu / Cửa / Khóa phòng</option>
                            <option value="Khác">Thiết bị khác</option>
                        </select>
                    </div>

                    <div class="mb-4">
                        @Html.LabelFor(m => m.Description, "Mô tả chi tiết tình trạng sự cố:", new { @class = "form-label fw-bold" })
                        @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = "4", placeholder = "Mô tả cụ thể để thợ mang đúng dụng cụ/vật tư thay thế...", required = "required" })
                        @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger small" })
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a href="@Url.Action("Index", "StudentPortal")" class="btn btn-secondary px-4">Hủy</a>
                        <button type="submit" class="btn btn-warning text-dark fw-bold px-4">
                            <i class="bi bi-send-fill me-1"></i> Gửi phiếu báo hỏng
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
