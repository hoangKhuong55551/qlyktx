@model Qlykytucxa.Models.IncidentRequest

@{
    ViewBag.Title = "Xử lý Sự cố & Bảo trì";
}

<div class="card shadow-sm border-0 rounded-4" style="max-width: 800px; margin: 0 auto;">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
            <div>
                <h4 class="fw-bold text-primary mb-1">
                    <i class="bi bi-wrench-adjustable me-2"></i>Cập nhật Tiến độ & Xử lý Sự cố
                </h4>
                <p class="text-muted mb-0 small">Sự cố phòng: <strong>Phòng @Model.RoomNumber</strong> | Ngày báo: @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
            </div>
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Quay lại
            </a>
        </div>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.Id)
            @Html.HiddenFor(model => model.CreatedAt)
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

            <div class="row g-3">
                <div class="col-md-6">
                    @Html.LabelFor(model => model.RoomId, "Phòng phát sinh sự cố", htmlAttributes: new { @class = "form-label fw-bold" })
                    @Html.DropDownList("RoomId", null, htmlAttributes: new { @class = "form-select", @required = "required" })
                    @Html.ValidationMessageFor(model => model.RoomId, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(model => model.Category, "Loại sự cố", htmlAttributes: new { @class = "form-label fw-bold" })
                    @Html.DropDownListFor(model => model.Category, new SelectList(new[] { "Điện", "Nước", "Điều hòa", "Giường tủ", "Khác" }, Model.Category), new { @class = "form-select", @required = "required" })
                    @Html.ValidationMessageFor(model => model.Category, "", new { @class = "text-danger" })
                </div>

                <div class="col-12">
                    @Html.LabelFor(model => model.Title, "Tiêu đề sự cố", htmlAttributes: new { @class = "form-label fw-bold" })
                    @Html.EditorFor(model => model.Title, new { htmlAttributes = new { @class = "form-control", @required = "required" } })
                    @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" })
                </div>

                <div class="col-12">
                    @Html.LabelFor(model => model.Description, "Mô tả chi tiết", htmlAttributes: new { @class = "form-label fw-bold" })
                    @Html.TextAreaFor(model => model.Description, 3, 50, new { @class = "form-control", @required = "required" })
                    @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(model => model.ReporterName, "Người báo hỏng", htmlAttributes: new { @class = "form-label fw-bold" })
                    @Html.EditorFor(model => model.ReporterName, new { htmlAttributes = new { @class = "form-control", @required = "required" } })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(model => model.AssignedTo, "Nhân viên phụ trách sửa chữa", htmlAttributes: new { @class = "form-label fw-bold" })
                    @Html.EditorFor(model => model.AssignedTo, new { htmlAttributes = new { @class = "form-control", placeholder = "VD: Chú Tuấn (Thợ điện)" } })
                </div>

                <!-- Cụm xử lý trạng thái & Chi phí -->
                <div class="col-md-6">
                    @Html.LabelFor(model => model.Status, "Trạng thái xử lý", htmlAttributes: new { @class = "form-label fw-bold text-primary" })
                    @Html.DropDownListFor(model => model.Status, new SelectList(new[] { "Mới tiếp nhận", "Đang xử lý", "Đã hoàn thành" }, Model.Status), new { @class = "form-select border-primary" })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(model => model.Cost, "Chi phí sửa chữa thực tế (VNĐ)", htmlAttributes: new { @class = "form-label fw-bold text-danger" })
                    @Html.EditorFor(model => model.Cost, new { htmlAttributes = new { @class = "form-control border-danger", type = "number", min = "0", step = "1000" } })
                    <small class="text-muted">Nhập số tiền đã chi trả phụ tùng/vật tư (nếu có)</small>
                </div>

                <div class="col-12 pt-3 border-top text-end">
                    <button type="submit" class="btn btn-primary btn-lg px-4 shadow-sm">
                        <i class="bi bi-save me-1"></i> Lưu cập nhật
                    </button>
                    <a href="@Url.Action("Index")" class="btn btn-secondary btn-lg px-3 ms-2">Quay lại</a>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
