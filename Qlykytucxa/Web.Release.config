<?xml version="1.0"?>
<!-- Cau hinh tu dong ap dung khi Publish o che do Release (len hosting). -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">

  <!--
    Connection string cho hosting: KHONG ghi mat khau that vao file nay (file nam trong git).
    Sau khi upload, mo Web.config TREN HOSTING va thay 4 cho: SERVER_HOSTING, TEN_DATABASE, USER_DB, MAT_KHAU_DB.
  -->
  <connectionStrings>
    <add name="MiniDormDBEntities"
         connectionString="metadata=res://*/Models.Model1.csdl|res://*/Models.Model1.ssdl|res://*/Models.Model1.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=SERVER_HOSTING;initial catalog=TEN_DATABASE;user id=USER_DB;password=MAT_KHAU_DB;TrustServerCertificate=True;MultipleActiveResultSets=True;App=EntityFramework&quot;"
         xdt:Transform="SetAttributes(connectionString)" xdt:Locator="Match(name)" />
  </connectionStrings>

  <system.web>
    <!-- Tat che do debug (chay nhanh hon, khong lo thong tin) -->
    <compilation xdt:Transform="RemoveAttributes(debug)" />
    <!-- An header phien ban ASP.NET -->
    <httpRuntime enableVersionHeader="false" xdt:Transform="SetAttributes(enableVersionHeader)" />
    <!-- Nguoi ngoai chi thay trang loi than thien (Views/Shared/Error.cshtml), khong thay stack trace / chuoi ket noi.
         Can xem loi chi tiet tren hosting: tam doi thanh mode="Off" roi doi lai. -->
    <customErrors mode="RemoteOnly" xdt:Transform="Insert" />
    <!-- Cookie phien dang nhap khong doc duoc bang JavaScript -->
    <httpCookies httpOnlyCookies="true" xdt:Transform="Insert" />
    <sessionState timeout="30" xdt:Transform="Insert" />
  </system.web>

  <system.webServer xdt:Transform="Insert">
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
